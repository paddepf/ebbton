{
  "name": "ebbton",
  "version": "1.1.3",
  "description": "Aufnahmesoftware für Gottesdienste mit ChurchTools-Ablaufplan, Abschnitten und Netzwerksteuerung",
  "main": "src/main/main.js",
  "author": "paddepf",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:tools": "electron . --dev --devtools",
    "dist": "electron-builder --win",
    "publish": "electron-builder --win --publish always",
    "dist:mac": "electron-builder --mac",
    "publish:mac": "electron-builder --mac --publish always",
    "test": "node --test"
  },
  "dependencies": {
    "audify": "1.10.1",
    "electron-updater": "^6.8.9",
    "wasm-media-encoders": "^0.7.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "de.ebbp.ebbton",
    "productName": "Ebbton",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/audify/{vendor,src}/**",
      "!node_modules/audify/{CMakeLists.txt,binding.gyp,tsconfig.json,.gitmodules}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Ebbton"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ebbton nimmt über den gewählten Audioeingang den Gottesdienst auf.",
        "LSMinimumSystemVersion": "13.0"
      },
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Ebbton ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "paddepf",
        "repo": "ebbton",
        "private": false,
        "releaseType": "draft"
      }
    ]
  }
}
